# AI 模型配置模板
# 使用方法：复制本文件为 .env，然后填写下面的值。
# 注意：.env 已被 .gitignore 忽略，不会提交到 git，请放心填写真实 Key。

# 是否使用 mock（true=不调真实模型，false=调用真实模型）
AI_USE_MOCK=true

# 你的 API Key
AI_API_KEY=

# OpenAI 兼容的 API 地址（DeepSeek、智谱、通义等均可）
AI_BASE_URL=https://api.openai.com/v1

# 模型名称
AI_MODEL=gpt-4o-mini

# ===== 计价（R4 Token 费用统计，可选）=====
# 未设置时使用默认值：DeepSeek V4 Flash 官方价（人民币/百万 tokens，空闲时段）
# 输入单价（每 price_unit 个 token 的价格，单位：元）
AI_INPUT_PRICE=1.5
# 输出单价（每 price_unit 个 token 的价格，单位：元）
AI_OUTPUT_PRICE=4.5
# 计价单位（多少 token 算一份），默认 1000000（1M）
AI_PRICE_UNIT=1000000
# 货币单位
AI_CURRENCY=CNY
