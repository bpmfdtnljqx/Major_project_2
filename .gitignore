# ==================== Python ====================
# 字节码 / 优化文件
__pycache__/
*.py[cod]
*$py.class

# C 扩展
*.so

# 打包 / 分发产物
build/
dist/
*.egg-info/
.eggs/

# ==================== 虚拟环境 ====================
.venv/
venv/
env/
ENV/

# ==================== 测试与覆盖率 ====================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.dmypy.json

# ==================== 环境变量 / 密钥 ====================
# 禁止提交含密钥的配置（AI 模块的模型 api_key 等）
.env
.env.*
!.env.example
*.local

# ==================== 日志 ====================
*.log
logs/

# ==================== IDE / 编辑器 ====================
.idea/
.vscode/
*.swp
*.swo
*~

# ==================== 操作系统 ====================
.DS_Store
Thumbs.db

# ==================== 运行时数据（不提交到 git） ====================
# 评测临时目录：用户提交的代码文件、编译产物、运行临时文件
tmp/
temp/
runs/

# 运行时动态数据：题目 JSON、用户/提交/日志等（SQLite 数据库）
data/
problems/
*.db
*.sqlite
*.sqlite3

# ==================== 工具数据 ====================
.workbuddy/
.agents/
.claude/
